# ---- Backend (set on Render → Environment) ----
PORT=3001
NODE_ENV=production
# Frontend origin(s) allowed to connect via Socket.IO.
# Comma-separate for multiple: https://vapor.chat,https://www.vapor.chat
CORS_ORIGIN=https://www.vaporchat.dev

# ---- Frontend (set on Vercel → Settings → Environment Variables) ----
# Must start with VITE_ to be embedded in the client bundle at build time.
# This is NOT a secret — it's just the public backend address.
VITE_API_URL=https://api.vapor.chat
# Canonical public origin used for every shared invite (not the Vercel preview URL).
VITE_PUBLIC_APP_ORIGIN=https://www.vaporchat.dev

# ---- Voice TURN relay (optional, but needed for restricted networks) ----
# Google STUN alone fails on symmetric NAT, mobile CGNAT, and locked-down
# corporate/university networks — those users hear silence. A TURN relay fixes
# it. List a TURNS over TCP/443 url first so it survives networks that block UDP.
# Comma-separate multiple urls. These are embedded at BUILD time — redeploy after changing.
# VITE_TURN_URL=turns:turn.example.com:443?transport=tcp,turn:turn.example.com:3478
# VITE_TURN_USERNAME=your-turn-username
# VITE_TURN_CREDENTIAL=your-turn-credential
